clc;
clear;
close all;

%% ==========================================
% EXPERIMENT 10
% 5G Network Slicing Environment Using MATLAB
%% ==========================================

%% Common Network Slices

slices = {'eMBB','URLLC','mMTC','Private','IoT'};

%% ==========================================
% OBJECTIVE 1
% Analyze Number of Network Slices
%% ==========================================

count = [1 1 1 1 1];

%% ==========================================
% OBJECTIVE 2
% Compare Slice Utilization
%% ==========================================

utilization = [85 70 60 75 50];

%% ==========================================
% OBJECTIVE 3
% Analyze End-to-End Latency
%% ==========================================

latency = [25 5 40 15 60];

%% ==========================================
% DISPLAY RESULTS
%% ==========================================

disp('==========================================');
disp('       5G NETWORK SLICING RESULTS');
disp('==========================================');

disp(' ');
disp('Objective 1 - Number of Network Slices');
disp('Slice Type        Number of Slices');

for i = 1:length(slices)
    fprintf('%-15s %d\n',slices{i},count(i));
end

disp(' ');
disp('Objective 2 - Slice Utilization');
disp('Slice Type        Utilization (%)');

for i = 1:length(slices)
    fprintf('%-15s %d\n',slices{i},utilization(i));
end

disp(' ');
disp('Objective 3 - End-to-End Latency');
disp('Slice Type        Latency (ms)');

for i = 1:length(slices)
    fprintf('%-15s %d\n',slices{i},latency(i));
end

%% ==========================================
% ALL OBJECTIVES IN ONE FIGURE
%% ==========================================

figure('Name','Experiment 10 - 5G Network Slicing');

%% Objective 1 - Number of Slices

subplot(3,2,1)

bar(count)

grid on
xlabel('Network Slice Type')
ylabel('Number of Network Slices')
title('Number of Configured 5G Network Slices')

xticks(1:5)
xticklabels(slices)
ylim([0 2])


%% Objective 1 - Slice Distribution

subplot(3,2,2)

pie(count)

title('5G Network Slice Distribution')
legend(slices)


%% Objective 2 - Slice Utilization

subplot(3,2,3)

bar(utilization)

grid on
xlabel('Network Slice Type')
ylabel('Slice Utilization (%)')
title('Slice Utilization in 5G Network Slicing')

xticks(1:5)
xticklabels(slices)
ylim([0 100])


%% Objective 2 - Utilization Comparison

subplot(3,2,4)

plot(1:5,utilization,'-o','LineWidth',2)

grid on
xlabel('Network Slice Type')
ylabel('Utilization (%)')
title('Slice Utilization Comparison')

xticks(1:5)
xticklabels(slices)
ylim([0 100])


%% Objective 3 - End-to-End Latency

subplot(3,2,5)

plot(1:5,latency,'-o','LineWidth',2,'MarkerSize',8)

grid on
xticks(1:5)
xticklabels(slices)

xlabel('Network Slice Type')
ylabel('End-to-End Latency (ms)')
title('5G Network Slicing: End-to-End Latency')

ylim([0 70])


%% Objective 3 - Latency Comparison

subplot(3,2,6)

bar(latency)

grid on
xlabel('Network Slice Type')
ylabel('Latency (ms)')
title('Latency Comparison of Network Slices')

xticks(1:5)
xticklabels(slices)
ylim([0 70])
