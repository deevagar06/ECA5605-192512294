clc;
clear;
close all;

%% ==========================
% Objective 1: TDMA Time Slot Structure
%% ==========================
FrameTime = 4.615;      % ms
TotalSlots = 8;
SlotDuration = FrameTime/TotalSlots;

t = 0:SlotDuration:FrameTime;

figure('Name','Experiment 2 - TDMA Slot Allocation');

subplot(3,2,1);
stem(t,ones(size(t)),'filled','LineWidth',1.5);
title('TDMA Time Slot Structure');
xlabel('Time (ms)');
ylabel('Slot');
grid on;

subplot(3,2,2);
plot(t,ones(size(t)),'-o','LineWidth',1.5);
title('Continuous Slot Allocation');
xlabel('Time (ms)');
ylabel('Slot');
grid on;

%% ==========================
% Objective 2: Frame Utilization
%% ==========================
AllocatedSlots = 6;
FreeSlots = TotalSlots - AllocatedSlots;
Utilization = (AllocatedSlots/TotalSlots)*100;

disp('Frame Utilization (%) = ');
disp(Utilization);

subplot(3,2,3);
plot([1 2],[AllocatedSlots FreeSlots],'-o','LineWidth',2);
xticks([1 2]);
xticklabels({'Allocated','Free'});
title('Allocated vs Free Slots');
ylabel('Number of Slots');
grid on;

subplot(3,2,4);
pie([AllocatedSlots FreeSlots]);
legend('Allocated','Free');
title(['Frame Utilization = ' num2str(Utilization) '%']);

%% ==========================
% Objective 3: User-wise Slot Allocation
%% ==========================
Users = 1:8;
AvailableSlots = 5;

Allocation = zeros(1,8);
Allocation(1:AvailableSlots)=1;

Blocked = 1-Allocation;

disp('User-wise Slot Allocation');
disp(table(Users',Allocation',...
'VariableNames',{'User','Allocated(1=Yes,0=No)'}));

subplot(3,2,5);
stem(Users,Allocation,'filled','LineWidth',2);
title('User Slot Allocation');
xlabel('Users');
ylabel('Allocated');
ylim([-0.2 1.2]);
grid on;

subplot(3,2,6);
plot(Users,Allocation,'-o','LineWidth',2);
hold on;
plot(Users,Blocked,'-s','LineWidth',2);
legend('Allocated','Blocked');
title('Allocated vs Blocked Users');
xlabel('Users');
ylabel('Status');
ylim([-0.2 1.2]);
grid on;
